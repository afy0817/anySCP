<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration 'binaries': first signing request of the
     ko build workflow (anyscp.exe). `version` is the app version from
     src-tauri/tauri.conf.json, passed in by the workflow. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="anyscp.exe" product-name="anySCP" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
