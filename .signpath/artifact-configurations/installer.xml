<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration 'installer': second signing request of the
     ko build workflow (the NSIS installer holding the signed anyscp.exe). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="setup.exe" product-name="anySCP" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
